//! Modelo de posição e avaliação estática.
//!
//! Por que um `Snapshot` em vez de avaliar `Game` direto: `Game` carrega
//! `Vec<Box<dyn Agent>>` e não é clonável, então busca precisa de uma
//! representação própria. O snapshot também isola a IA das camadas — ele é
//! construído uma vez por decisão chamando `layers::characteristics`, e depois
//! a simulação mexe só em números.
use mtg_core::engine::{cast, Game};
use mtg_core::event::Step;
use mtg_core::ids::{ObjectId, PlayerId};
use mtg_core::ir::Keyword;
use mtg_core::state::GameState;
use mtg_core::zone::ZoneId;

use crate::politics;
use crate::table::{self, OppRef, OpponentInfo, COMMANDER_LETHAL};

// ---------------------------------------------------------------------------
// Pesos
// ---------------------------------------------------------------------------
//
// Unidade: centipontos. Os pesos foram calibrados para que as trocas clássicas
// de Magic caiam do lado certo:
//   - criatura 2/2 = 201; carta na mão = 85; 3 vidas = 90. Trocar 3 de dano
//     por um corpo 2/2 é bom negócio (201 > 175), trocar uma carta não é.
//   - 1/1 = 128, abaixo do limiar de remoção de 2 manas (190): não se gasta
//     Doom Blade em Elfo.

/// Um ponto de vida. Vida é recurso, não objetivo: só o último ponto importa,
/// e disso cuidam os termos de letalidade.
pub const LIFE: i64 = 30;
/// Corpo em campo, independente de tamanho: qualquer criatura bloqueia.
pub const CREATURE_BASE: i64 = 55;
/// Poder ganha o jogo (relógio); vale mais que resistência.
pub const POWER: i64 = 45;
pub const TOUGHNESS: i64 = 28;
/// Evasão multiplica o poder porque converte poder em dano de verdade.
pub const EVASION: i64 = 12;
/// Carta na mão: opção futura. Menos que um corpo já em campo (tempo importa).
pub const CARD_IN_HAND: i64 = 85;
pub const NONLAND_PERMANENT: i64 = 65;
/// Fonte de mana até a sétima; depois o excedente quase não paga.
pub const MANA_SOURCE: i64 = 22;
pub const MANA_SURPLUS: i64 = 4;
pub const MANA_COLOR: i64 = 12;
/// Morrer no próximo ataque adversário domina qualquer vantagem material.
pub const LETHAL_THREAT: i64 = 900;
pub const LETHAL_CHANCE: i64 = 1100;
/// Biblioteca vazia = derrota na próxima compra (CR 704.5b).
pub const DECKING: i64 = 4000;
pub const TERMINAL: i64 = 1_000_000;
/// Contador de veneno: relógio paralelo de dez pontos (CR 704.5c).
pub const POISON: i64 = 90;
/// Oponente já eliminado: um relógio a menos apontado para mim e um passo a
/// menos até a vitória. Vale mais que qualquer troca isolada de material.
pub const OPPONENT_ELIMINATED: i64 = 1500;
/// Um ponto de dano de comandante (CR 903.10a). Vale o dobro de um ponto de
/// vida: são 21 para matar onde a vida inicial de Commander pede 40.
pub const COMMANDER_DAMAGE: i64 = 60;

/// Como a posição é comparada com a mesa: parte contra o líder, parte contra a
/// média. Somam 10, então com **um** oponente `líder == média` e a fórmula
/// colapsa exatamente na diferença do duelo — é o que garante que ligar
/// multijogador não mexeu em nenhuma decisão de partida de dois.
const FIELD_LEADER_SHARE: i64 = 6;
const FIELD_AVERAGE_SHARE: i64 = 4;

/// Limiar de relevância de alvo de remoção, em função do custo da remoção.
/// Gastar 2 manas num 1/1 é perda de carta; gastar num 2/2 já se paga.
pub fn removal_threshold(spell_mana_value: u32) -> i64 {
    100 + spell_mana_value as i64 * 45
}

// ---------------------------------------------------------------------------
// Lado
// ---------------------------------------------------------------------------

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Side {
    Me,
    Opponent,
}

impl Side {
    pub fn other(self) -> Side {
        match self {
            Side::Me => Side::Opponent,
            Side::Opponent => Side::Me,
        }
    }
}

// ---------------------------------------------------------------------------
// Palavras-chave que a IA usa
// ---------------------------------------------------------------------------

/// Só as palavras-chave que mudam decisão de combate ou de alvo. Guardar o
/// `Vec<Keyword>` inteiro obrigaria a varrer vetor dentro do laço de simulação.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct Traits {
    pub flying: bool,
    pub reach: bool,
    pub trample: bool,
    pub first_strike: bool,
    pub double_strike: bool,
    pub deathtouch: bool,
    pub lifelink: bool,
    pub vigilance: bool,
    pub haste: bool,
    pub menace: bool,
    pub defender: bool,
    pub indestructible: bool,
    pub hexproof: bool,
    pub shroud: bool,
    pub protection: bool,
}

impl Traits {
    pub fn from_keywords(keywords: &[Keyword]) -> Traits {
        let mut t = Traits::default();
        for k in keywords {
            match k {
                Keyword::Flying => t.flying = true,
                Keyword::Reach => t.reach = true,
                Keyword::Trample => t.trample = true,
                Keyword::FirstStrike => t.first_strike = true,
                Keyword::DoubleStrike => t.double_strike = true,
                Keyword::Deathtouch => t.deathtouch = true,
                Keyword::Lifelink => t.lifelink = true,
                Keyword::Vigilance => t.vigilance = true,
                Keyword::Haste => t.haste = true,
                Keyword::Menace => t.menace = true,
                Keyword::Defender => t.defender = true,
                Keyword::Indestructible => t.indestructible = true,
                Keyword::Hexproof => t.hexproof = true,
                Keyword::Shroud => t.shroud = true,
                Keyword::Protection(_) => t.protection = true,
                _ => {}
            }
        }
        t
    }

    /// Não pode ser alvo de mágica adversária (CR 702.11, 702.18).
    pub fn untargetable_by_opponent(self) -> bool {
        self.hexproof || self.shroud
    }

    /// Causa dano no passo de primeiro golpe (CR 510.4).
    pub fn strikes_first(self) -> bool {
        self.first_strike || self.double_strike
    }

    /// Causa dano no passo normal. Golpe duplo bate nos dois.
    pub fn strikes_normal(self) -> bool {
        !self.first_strike || self.double_strike
    }
}

// ---------------------------------------------------------------------------
// Criatura
// ---------------------------------------------------------------------------

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CreatureInfo {
    pub id: ObjectId,
    pub controller: PlayerId,
    pub power: i32,
    pub toughness: i32,
    pub damage: i32,
    pub mana_value: u32,
    pub tapped: bool,
    pub summoning_sick: bool,
    pub attacking: bool,
    pub blocking: bool,
    pub cant_attack: bool,
    pub cant_block: bool,
    pub cant_be_blocked: bool,
    pub traits: Traits,
}

impl CreatureInfo {
    /// Criatura sem texto — usada em teste e na previsão de "o que entra em
    /// campo se eu lançar esta carta".
    pub fn vanilla(id: ObjectId, controller: PlayerId, power: i32, toughness: i32) -> CreatureInfo {
        CreatureInfo {
            id,
            controller,
            power,
            toughness,
            damage: 0,
            mana_value: 0,
            tapped: false,
            summoning_sick: false,
            attacking: false,
            blocking: false,
            cant_attack: false,
            cant_block: false,
            cant_be_blocked: false,
            traits: Traits::default(),
        }
    }

    pub fn effective_toughness(&self) -> i32 {
        self.toughness - self.damage
    }

    /// Poder que este corpo converte em dano recorrente. Criatura com defensor
    /// não ataca, então o poder dela só rende bloqueando.
    fn offensive_power(&self) -> i32 {
        if self.traits.defender || self.cant_attack {
            self.power.max(0) / 3
        } else {
            self.power.max(0)
        }
    }

    /// Pode declarar ataque agora (CR 508.1a).
    pub fn can_attack_now(&self) -> bool {
        !self.tapped
            && !self.cant_attack
            && !self.traits.defender
            && (!self.summoning_sick || self.traits.haste)
            && self.power > 0
    }

    /// Pode ser declarada bloqueadora agora (CR 509.1a).
    pub fn can_block_now(&self) -> bool {
        !self.tapped && !self.cant_block && !self.attacking
    }

    /// No próximo turno tudo desvira e o enjoo passa; só a trava persiste.
    pub fn can_attack_next_turn(&self) -> bool {
        !self.cant_attack && !self.traits.defender && self.power > 0
    }

    /// Este bloqueador consegue bloquear aquele atacante (CR 509.1b).
    /// Ameaçar exige dois bloqueadores e é tratado por quem chama.
    pub fn can_block_attacker(&self, attacker: &CreatureInfo) -> bool {
        if attacker.cant_be_blocked {
            return false;
        }
        if attacker.traits.flying && !(self.traits.flying || self.traits.reach) {
            return false;
        }
        true
    }

    /// O dano deste combatente é letal para `other` (CR 704.5g, 702.2b).
    pub fn deals_lethal_to(&self, other: &CreatureInfo) -> bool {
        if other.traits.indestructible || self.power <= 0 {
            return false;
        }
        self.traits.deathtouch || self.power >= other.effective_toughness()
    }

    /// Quanto vale esta criatura, em centipontos.
    pub fn value(&self) -> i64 {
        let eff_t = self.effective_toughness();
        // Resistência ≤ 0 morre por ação baseada em estado (CR 704.5f).
        if eff_t <= 0 {
            return 0;
        }
        let power = self.offensive_power() as i64;
        let mut v = CREATURE_BASE + power * POWER + eff_t as i64 * TOUGHNESS;
        if self.traits.flying || self.traits.menace || self.cant_be_blocked {
            v += power * EVASION;
        }
        if self.traits.trample {
            v += power * 6;
        }
        if self.traits.lifelink {
            v += power * 8;
        }
        if self.traits.double_strike {
            v += power * 20;
        } else if self.traits.first_strike {
            v += 25;
        }
        if self.traits.deathtouch {
            v += 40;
        }
        if self.traits.vigilance {
            v += 18;
        }
        if self.traits.indestructible {
            v += 60;
        }
        if self.traits.untargetable_by_opponent() {
            v += 30;
        }
        // Enjoo é desvantagem temporária: desconto pequeno, não estrutural.
        if self.summoning_sick && !self.traits.haste {
            v -= 12;
        }
        if self.tapped {
            v -= 10;
        }
        v
    }
}

// ---------------------------------------------------------------------------
// Snapshot
// ---------------------------------------------------------------------------

/// Retrato da posição do ponto de vista de um jogador.
///
/// **Por que continua tendo dois lados.** Combate em Magic é sempre entre dois
/// jogadores: só o jogador defensor declara bloqueadores (CR 509.1a), e todo o
/// modelo de `sim` depende disso. Então os campos `opp_*` não descrevem "o
/// oponente" e sim **o oponente em foco** — em duelo é o único que existe, em
/// mesa cheia é aquele contra quem esta decisão está sendo pesada.
///
/// Os demais oponentes vivem em `others`, com o mesmo conteúdo público. Quem
/// precisa tratar a mesa inteira de forma uniforme usa `opponents_view()`, que
/// devolve foco e resto na mesma lista sem clonar criatura.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Snapshot {
    pub me: PlayerId,
    /// Oponente em foco. Ver a nota do tipo: não é "o oponente".
    pub opponent: PlayerId,
    pub my_life: i32,
    pub opp_life: i32,
    pub my_poison: i32,
    pub opp_poison: i32,
    pub my_creatures: Vec<CreatureInfo>,
    pub opp_creatures: Vec<CreatureInfo>,
    pub my_hand: usize,
    pub opp_hand: usize,
    pub my_lands: usize,
    pub opp_lands: usize,
    pub my_nonland_permanents: usize,
    pub opp_nonland_permanents: usize,
    pub my_mana_sources: usize,
    pub opp_mana_sources: usize,
    pub my_mana_colors: u32,
    pub opp_mana_colors: u32,
    /// Mana desvirada agora — usada para decidir se vale segurar resposta.
    /// Fora da avaliação de propósito: senão a IA odiaria gastar mana.
    pub my_available_mana: u16,
    pub my_library: usize,
    pub opp_library: usize,
    pub is_my_turn: bool,
    pub step: Step,
    pub turn: u32,
    pub lands_played_this_turn: u8,
    pub max_lands_per_turn: u8,

    /// Oponentes vivos além do foco, em ordem de `PlayerId`. Vazio em duelo,
    /// e é por isso que nada do caminho de dois jogadores mudou.
    pub others: Vec<OpponentInfo>,
    /// Oponentes que já saíram da partida antes deste retrato.
    pub eliminated_opponents: usize,
    /// CR 903.10a — relógio do comandante do foco contra mim.
    pub opp_commander_damage_to_me: i32,
    /// CR 903.10a — relógio do meu comandante contra o foco.
    pub my_commander_damage_to_opp: i32,
}

impl Snapshot {
    pub fn empty(me: PlayerId, opponent: PlayerId) -> Snapshot {
        Snapshot {
            me,
            opponent,
            my_life: 20,
            opp_life: 20,
            my_poison: 0,
            opp_poison: 0,
            my_creatures: Vec::new(),
            opp_creatures: Vec::new(),
            my_hand: 0,
            opp_hand: 0,
            my_lands: 0,
            opp_lands: 0,
            my_nonland_permanents: 0,
            opp_nonland_permanents: 0,
            my_mana_sources: 0,
            opp_mana_sources: 0,
            my_mana_colors: 0,
            opp_mana_colors: 0,
            my_available_mana: 0,
            my_library: 40,
            opp_library: 40,
            is_my_turn: true,
            step: Step::PrecombatMain,
            turn: 1,
            lands_played_this_turn: 0,
            max_lands_per_turn: 1,
            others: Vec::new(),
            eliminated_opponents: 0,
            opp_commander_damage_to_me: 0,
            my_commander_damage_to_opp: 0,
        }
    }

    /// Foco e demais oponentes na mesma lista, em ordem estável (foco primeiro,
    /// depois `others`, que já vem ordenado por `PlayerId`).
    pub fn opponents_view(&self) -> Vec<OppRef<'_>> {
        let mut out = Vec::with_capacity(1 + self.others.len());
        out.push(OppRef {
            id: self.opponent,
            life: self.opp_life,
            poison: self.opp_poison,
            hand: self.opp_hand,
            library: self.opp_library,
            lands: self.opp_lands,
            nonland_permanents: self.opp_nonland_permanents,
            mana_sources: self.opp_mana_sources,
            mana_colors: self.opp_mana_colors,
            creatures: &self.opp_creatures,
            commander_damage_to_me: self.opp_commander_damage_to_me,
            my_commander_damage: self.my_commander_damage_to_opp,
        });
        out.extend(self.others.iter().map(OpponentInfo::as_ref));
        out
    }

    /// Oponentes ainda na partida.
    pub fn living_opponents(&self) -> usize {
        self.opponents_view().iter().filter(|o| o.is_alive()).count()
    }

    /// Mesmo retrato, com o foco trocado para este jogador. É assim que uma
    /// declaração de ataque contra o jogador B é medida: `sim` sempre resolve
    /// combate contra o lado em foco, então o foco tem de ser o defensor.
    /// Jogador desconhecido devolve o retrato inalterado.
    pub fn focused_on(&self, target: PlayerId) -> Snapshot {
        if target == self.opponent || target == self.me {
            return self.clone();
        }
        let Some(index) = self.others.iter().position(|o| o.id == target) else {
            return self.clone();
        };
        let mut next = self.clone();
        let new_focus = next.others.remove(index);
        let old_focus = OpponentInfo {
            id: self.opponent,
            life: self.opp_life,
            poison: self.opp_poison,
            hand: self.opp_hand,
            library: self.opp_library,
            lands: self.opp_lands,
            nonland_permanents: self.opp_nonland_permanents,
            mana_sources: self.opp_mana_sources,
            mana_colors: self.opp_mana_colors,
            creatures: self.opp_creatures.clone(),
            commander_damage_to_me: self.opp_commander_damage_to_me,
            my_commander_damage: self.my_commander_damage_to_opp,
        };
        next.opponent = new_focus.id;
        next.opp_life = new_focus.life;
        next.opp_poison = new_focus.poison;
        next.opp_hand = new_focus.hand;
        next.opp_library = new_focus.library;
        next.opp_lands = new_focus.lands;
        next.opp_nonland_permanents = new_focus.nonland_permanents;
        next.opp_mana_sources = new_focus.mana_sources;
        next.opp_mana_colors = new_focus.mana_colors;
        next.opp_creatures = new_focus.creatures;
        next.opp_commander_damage_to_me = new_focus.commander_damage_to_me;
        next.my_commander_damage_to_opp = new_focus.my_commander_damage;
        // Ordem por `PlayerId`: nenhuma decisão pode depender de quem foi foco
        // antes, senão a mesma posição daria notas diferentes.
        next.others.push(old_focus);
        next.others.sort_by_key(|o| o.id.0);
        next
    }

    pub fn creatures(&self, side: Side) -> &Vec<CreatureInfo> {
        match side {
            Side::Me => &self.my_creatures,
            Side::Opponent => &self.opp_creatures,
        }
    }

    pub fn creatures_mut(&mut self, side: Side) -> &mut Vec<CreatureInfo> {
        match side {
            Side::Me => &mut self.my_creatures,
            Side::Opponent => &mut self.opp_creatures,
        }
    }

    pub fn life(&self, side: Side) -> i32 {
        match side {
            Side::Me => self.my_life,
            Side::Opponent => self.opp_life,
        }
    }

    pub fn add_life(&mut self, side: Side, delta: i32) {
        match side {
            Side::Me => self.my_life += delta,
            Side::Opponent => self.opp_life += delta,
        }
    }

    pub fn hand_size(&self, side: Side) -> usize {
        match side {
            Side::Me => self.my_hand,
            Side::Opponent => self.opp_hand,
        }
    }

    /// Lado que controla este objeto, se ele for uma criatura em campo.
    /// Criatura de qualquer oponente, em foco ou não, é `Opponent`.
    pub fn side_of(&self, id: ObjectId) -> Option<Side> {
        if self.my_creatures.iter().any(|c| c.id == id) {
            return Some(Side::Me);
        }
        if self.opp_creatures.iter().any(|c| c.id == id) {
            return Some(Side::Opponent);
        }
        if self
            .others
            .iter()
            .any(|o| o.creatures.iter().any(|c| c.id == id))
        {
            return Some(Side::Opponent);
        }
        None
    }

    /// Quem controla esta criatura. Diferente de `side_of`: aqui o terceiro
    /// jogador da mesa não vira "o oponente", e é isso que faz remoção mirada
    /// num não-foco ser prevista no jogador certo.
    pub fn controller_of(&self, id: ObjectId) -> Option<PlayerId> {
        if self.my_creatures.iter().any(|c| c.id == id) {
            return Some(self.me);
        }
        if self.opp_creatures.iter().any(|c| c.id == id) {
            return Some(self.opponent);
        }
        self.others
            .iter()
            .find(|o| o.creatures.iter().any(|c| c.id == id))
            .map(|o| o.id)
    }

    pub fn find(&self, id: ObjectId) -> Option<&CreatureInfo> {
        self.my_creatures
            .iter()
            .chain(self.opp_creatures.iter())
            .chain(self.others.iter().flat_map(|o| o.creatures.iter()))
            .find(|c| c.id == id)
    }

    pub fn find_mut(&mut self, id: ObjectId) -> Option<&mut CreatureInfo> {
        self.my_creatures
            .iter_mut()
            .chain(self.opp_creatures.iter_mut())
            .chain(self.others.iter_mut().flat_map(|o| o.creatures.iter_mut()))
            .find(|c| c.id == id)
    }

    pub fn remove_creature(&mut self, id: ObjectId) {
        self.my_creatures.retain(|c| c.id != id);
        self.opp_creatures.retain(|c| c.id != id);
        for o in self.others.iter_mut() {
            o.creatures.retain(|c| c.id != id);
        }
    }

    // -----------------------------------------------------------------------
    // Acesso por jogador
    //
    // A previsão de efeito precisa saber *em qual* jogador escrever. Com dois
    // jogadores `Side` bastava; com quatro, mandar o dano de "cada oponente"
    // para o lado em foco creditaria a vida errada.
    // -----------------------------------------------------------------------

    /// Todos os jogadores da mesa, em ordem estável: eu, o foco, depois o
    /// resto por `PlayerId`.
    pub fn all_players(&self) -> Vec<PlayerId> {
        let mut out = Vec::with_capacity(2 + self.others.len());
        out.push(self.me);
        out.push(self.opponent);
        out.extend(self.others.iter().map(|o| o.id));
        out
    }

    /// Oponentes, em ordem estável.
    pub fn opponent_ids(&self) -> Vec<PlayerId> {
        let mut out = Vec::with_capacity(1 + self.others.len());
        out.push(self.opponent);
        out.extend(self.others.iter().map(|o| o.id));
        out
    }

    pub fn life_of(&self, p: PlayerId) -> i32 {
        if p == self.me {
            return self.my_life;
        }
        if p == self.opponent {
            return self.opp_life;
        }
        self.others
            .iter()
            .find(|o| o.id == p)
            .map_or(0, |o| o.life)
    }

    pub fn add_life_of(&mut self, p: PlayerId, delta: i32) {
        if p == self.me {
            self.my_life += delta;
        } else if p == self.opponent {
            self.opp_life += delta;
        } else if let Some(o) = self.others.iter_mut().find(|o| o.id == p) {
            o.life += delta;
        }
    }

    pub fn add_hand_of(&mut self, p: PlayerId, delta: i32) {
        let apply = |n: &mut usize| {
            *n = if delta >= 0 {
                n.saturating_add(delta as usize)
            } else {
                n.saturating_sub(delta.unsigned_abs() as usize)
            };
        };
        if p == self.me {
            apply(&mut self.my_hand);
        } else if p == self.opponent {
            apply(&mut self.opp_hand);
        } else if let Some(o) = self.others.iter_mut().find(|o| o.id == p) {
            apply(&mut o.hand);
        }
    }

    pub fn add_library_of(&mut self, p: PlayerId, delta: i32) {
        let apply = |n: &mut usize| {
            *n = if delta >= 0 {
                n.saturating_add(delta as usize)
            } else {
                n.saturating_sub(delta.unsigned_abs() as usize)
            };
        };
        if p == self.me {
            apply(&mut self.my_library);
        } else if p == self.opponent {
            apply(&mut self.opp_library);
        } else if let Some(o) = self.others.iter_mut().find(|o| o.id == p) {
            apply(&mut o.library);
        }
    }

    pub fn creatures_of_mut(&mut self, p: PlayerId) -> Option<&mut Vec<CreatureInfo>> {
        if p == self.me {
            return Some(&mut self.my_creatures);
        }
        if p == self.opponent {
            return Some(&mut self.opp_creatures);
        }
        self.others
            .iter_mut()
            .find(|o| o.id == p)
            .map(|o| &mut o.creatures)
    }

    /// Monta o retrato a partir do motor. Só aqui a IA fala com `Game`.
    ///
    /// O foco sai de `politics::most_threatening`, não do primeiro oponente da
    /// lista: com três ou quatro jogadores, olhar sempre o vizinho da esquerda
    /// é como jogar de olhos fechados para quem está ganhando.
    pub fn from_game(game: &Game, me: PlayerId) -> Snapshot {
        let st = &game.state;

        // Ordem de `PlayerId`, nunca ordem de mapa: determinismo é requisito.
        let mut living: Vec<OpponentInfo> = Vec::new();
        let mut eliminated = 0usize;
        for p in st.players.iter() {
            if p.id == me {
                continue;
            }
            if p.has_lost {
                eliminated += 1;
                continue;
            }
            let mut info = OpponentInfo::new(p.id, p.life, p.poison);
            info.hand = zone_len(st, ZoneId::hand(p.id));
            info.library = zone_len(st, ZoneId::library(p.id));
            // CR 903.10 — os dois relógios, lidos do motor.
            info.commander_damage_to_me = table::commander_damage_between(st, p.id, me);
            info.my_commander_damage = table::commander_damage_between(st, me, p.id);
            living.push(info);
        }

        let mut my = SelfCounts::default();
        for id in zone_objects(st, ZoneId::BATTLEFIELD) {
            let Some(obj) = st.object(*id) else { continue };
            // CR 613: características vêm das camadas, nunca do CardDef cru.
            let Some(ch) = game.characteristics(*id) else {
                continue;
            };
            let mana = produces_mana(game, *id);
            let creature = if ch.type_line.is_creature() {
                Some(CreatureInfo {
                    id: *id,
                    controller: ch.controller,
                    power: ch.power,
                    toughness: ch.toughness,
                    damage: obj.damage,
                    mana_value: ch.mana_value,
                    tapped: obj.tapped,
                    summoning_sick: obj.summoning_sick,
                    attacking: obj.combat.is_attacking(),
                    blocking: obj.combat.is_blocking(),
                    cant_attack: ch.cant_attack,
                    cant_block: ch.cant_block,
                    cant_be_blocked: ch.cant_be_blocked,
                    traits: Traits::from_keywords(&ch.keywords),
                })
            } else {
                None
            };

            if ch.controller == me {
                my.mana_sources += usize::from(mana);
                match creature {
                    Some(c) => my.creatures.push(c),
                    None if ch.type_line.is_land() => my.lands += 1,
                    None => my.nonland_permanents += 1,
                }
            } else if let Some(o) = living.iter_mut().find(|o| o.id == ch.controller) {
                o.mana_sources += usize::from(mana);
                match creature {
                    Some(c) => o.creatures.push(c),
                    None if ch.type_line.is_land() => o.lands += 1,
                    None => o.nonland_permanents += 1,
                }
            }
        }

        for o in living.iter_mut() {
            o.mana_colors = color_count(&cast::available_mana(game, o.id));
        }

        let views: Vec<OppRef<'_>> = living.iter().map(OpponentInfo::as_ref).collect();
        let my_life = life_of(st, me);
        let focus_index = politics::most_threatening(my_life, &views);
        drop(views);
        let focus = focus_index.map(|i| living.remove(i));

        // Sem oponente vivo a partida já acabou; o retrato vazio faz
        // `evaluate` devolver terminal, que é a leitura correta.
        let opponent = focus
            .as_ref()
            .map_or_else(|| st.next_player(me), |o| o.id);
        let mut s = Snapshot::empty(me, opponent);
        s.my_life = my_life;
        s.my_poison = poison_of(st, me);
        s.my_hand = zone_len(st, ZoneId::hand(me));
        s.my_library = zone_len(st, ZoneId::library(me));
        s.my_creatures = my.creatures;
        s.my_lands = my.lands;
        s.my_nonland_permanents = my.nonland_permanents;
        s.my_mana_sources = my.mana_sources;
        s.is_my_turn = st.active_player == me;
        s.step = st.step;
        s.turn = st.turn;
        s.eliminated_opponents = eliminated;
        if let Some(p) = st.players.get(me.index()) {
            s.lands_played_this_turn = p.lands_played_this_turn;
            s.max_lands_per_turn = p.max_lands_per_turn;
        }
        match focus {
            Some(o) => {
                s.opp_life = o.life;
                s.opp_poison = o.poison;
                s.opp_hand = o.hand;
                s.opp_library = o.library;
                s.opp_lands = o.lands;
                s.opp_nonland_permanents = o.nonland_permanents;
                s.opp_mana_sources = o.mana_sources;
                s.opp_mana_colors = o.mana_colors;
                s.opp_creatures = o.creatures;
                s.opp_commander_damage_to_me = o.commander_damage_to_me;
                s.my_commander_damage_to_opp = o.my_commander_damage;
            }
            None => s.opp_life = 0,
        }
        s.others = living;

        let mine = cast::available_mana(game, me);
        s.my_available_mana = mine.total;
        s.my_mana_colors = color_count(&mine);
        s
    }
}

/// Acumulador do meu lado durante a varredura do campo de batalha.
#[derive(Debug, Default)]
struct SelfCounts {
    creatures: Vec<CreatureInfo>,
    lands: usize,
    nonland_permanents: usize,
    mana_sources: usize,
}

fn color_count(m: &cast::ManaAvailability) -> u32 {
    if m.any_color > 0 {
        // Fonte "qualquer cor" cobre o que faltar: leque completo.
        return 5;
    }
    m.by_color.iter().filter(|n| **n > 0).count() as u32
}

/// Permanente com habilidade de mana. Ler `CardDef` aqui é heurística de IA,
/// não decisão de regra — o motor continua dono das regras.
fn produces_mana(game: &Game, id: ObjectId) -> bool {
    let Some(obj) = game.state.object(id) else {
        return false;
    };
    match game.db.get(obj.card) {
        Some(def) => def.mana_abilities().next().is_some(),
        None => false,
    }
}

pub fn life_of(state: &GameState, p: PlayerId) -> i32 {
    state.players.get(p.index()).map_or(0, |x| x.life)
}

pub fn poison_of(state: &GameState, p: PlayerId) -> i32 {
    state.players.get(p.index()).map_or(0, |x| x.poison)
}

/// Acesso a zona sem indexação que possa entrar em pânico.
pub fn zone_objects(state: &GameState, z: ZoneId) -> &[ObjectId] {
    let key = (z.kind, z.owner.map_or(u8::MAX, |p| p.0));
    state
        .zones
        .get(&key)
        .map_or(&[][..], |zone| zone.objects.as_slice())
}

pub fn zone_len(state: &GameState, z: ZoneId) -> usize {
    zone_objects(state, z).len()
}

// ---------------------------------------------------------------------------
// Ameaça de combate
// ---------------------------------------------------------------------------

/// Dano que passa se `attackers` atacarem e `blockers` bloquearem o melhor
/// possível. Modelo guloso: cada bloqueador neutraliza o maior atacante que
/// consegue bloquear. Responde "eu morro?", não "vale a troca?".
pub fn unblocked_damage(attackers: &[&CreatureInfo], blockers: &[&CreatureInfo]) -> i32 {
    let mut order: Vec<&CreatureInfo> = attackers.to_vec();
    // Ordenação total por (poder, id) mantém o resultado igual em toda execução.
    order.sort_by(|a, b| b.power.cmp(&a.power).then(a.id.cmp(&b.id)));
    let mut free: Vec<&CreatureInfo> = blockers.to_vec();
    free.sort_by_key(|b| b.id);

    let mut total = 0;
    for atk in order {
        // Ameaçar exige dois bloqueadores (CR 702.110b).
        let needed = if atk.traits.menace { 2 } else { 1 };
        let mut chosen: Vec<usize> = Vec::new();
        for (i, b) in free.iter().enumerate() {
            if b.can_block_attacker(atk) {
                chosen.push(i);
                if chosen.len() == needed {
                    break;
                }
            }
        }
        if chosen.len() == needed {
            // Remover de trás para frente preserva os índices restantes.
            for i in chosen.into_iter().rev() {
                free.remove(i);
            }
            if atk.traits.trample {
                // Atropelar passa o excedente mesmo bloqueado (CR 702.19b).
                let absorbed = 1;
                total += (atk.power.max(0) - absorbed).max(0);
            }
        } else {
            total += atk.power.max(0);
        }
    }
    total
}

/// Dano que a mesa inteira me causaria nos próximos ataques. As criaturas
/// viradas e enjoadas deles contam (desviram no turno deles); as minhas viradas
/// não bloqueiam — é daí que sai a cautela ao atacar com tudo.
///
/// Com três ou quatro jogadores a conta muda de forma. Cada oponente ataca no
/// turno dele e eu desviro entre um e outro, então **somar** tudo superestima
/// grosseiramente; olhar só o pior subestima o cerco. O meio-termo usado aqui é
/// o pior turno inteiro mais metade do resto — e com um oponente só ele é
/// exatamente o valor de antes, então o duelo não mudou.
pub fn incoming_damage(s: &Snapshot) -> i32 {
    let blockers: Vec<&CreatureInfo> = s
        .my_creatures
        .iter()
        .filter(|c| !c.tapped && !c.cant_block)
        .collect();
    let mut per_opponent: Vec<i32> = s
        .opponents_view()
        .iter()
        .filter(|o| o.is_alive())
        .map(|o| {
            let attackers: Vec<&CreatureInfo> = o
                .creatures
                .iter()
                .filter(|c| c.can_attack_next_turn())
                .collect();
            unblocked_damage(&attackers, &blockers)
        })
        .collect();
    per_opponent.sort_unstable_by(|a, b| b.cmp(a));
    let worst = per_opponent.first().copied().unwrap_or(0);
    let rest: i32 = per_opponent.iter().skip(1).sum();
    worst + rest / 2
}

/// Dano que eu causaria no meu próximo ataque contra este oponente.
pub fn outgoing_damage_against(s: &Snapshot, o: &OppRef<'_>) -> i32 {
    let attackers: Vec<&CreatureInfo> = s
        .my_creatures
        .iter()
        .filter(|c| c.can_attack_next_turn())
        .collect();
    let blockers: Vec<&CreatureInfo> = o.creatures.iter().filter(|c| !c.cant_block).collect();
    unblocked_damage(&attackers, &blockers)
}

/// Dano que eu causaria no meu próximo ataque contra o oponente em foco.
pub fn outgoing_damage(s: &Snapshot) -> i32 {
    match s.opponents_view().first() {
        Some(o) => outgoing_damage_against(s, o),
        None => 0,
    }
}

fn mana_score(sources: usize, colors: u32) -> i64 {
    let capped = sources.min(7) as i64 * MANA_SOURCE;
    let surplus = sources.saturating_sub(7) as i64 * MANA_SURPLUS;
    capped + surplus + colors as i64 * MANA_COLOR
}

fn board_value(creatures: &[CreatureInfo]) -> i64 {
    creatures.iter().map(CreatureInfo::value).sum()
}

// ---------------------------------------------------------------------------
// Avaliação
// ---------------------------------------------------------------------------

/// Força bruta de uma posição isolada, na mesma unidade de `evaluate`.
/// Existe para que eu e cada oponente sejam medidos pela **mesma** régua — é o
/// que permite comparar a minha posição com a mesa inteira em vez de com um
/// vizinho escolhido a esmo.
fn strength(
    life: i32,
    poison: i32,
    creatures: &[CreatureInfo],
    hand: usize,
    nonland_permanents: usize,
    mana_sources: usize,
    mana_colors: u32,
) -> i64 {
    life as i64 * LIFE
        + board_value(creatures)
        + hand as i64 * CARD_IN_HAND
        + nonland_permanents as i64 * NONLAND_PERMANENT
        + mana_score(mana_sources, mana_colors)
        // Veneno é um relógio paralelo (CR 704.5c).
        - poison as i64 * POISON
}

fn my_strength(s: &Snapshot) -> i64 {
    strength(
        s.my_life,
        s.my_poison,
        &s.my_creatures,
        s.my_hand,
        s.my_nonland_permanents,
        s.my_mana_sources,
        s.my_mana_colors,
    )
}

fn opponent_strength(o: &OppRef<'_>) -> i64 {
    strength(
        o.life,
        o.poison,
        o.creatures,
        o.hand,
        o.nonland_permanents,
        o.mana_sources,
        o.mana_colors,
    )
}

/// Avaliação da posição do ponto de vista de `s.me`. Positivo = estou melhor.
///
/// Com um oponente a nota é a diferença entre nós dois, como sempre foi. Com
/// dois ou três, a diferença contra **um** deles não diz nada: dá para estar
/// ganhando do vizinho da esquerda e estar morto para o da direita. Então a
/// nota passa a ser a minha força contra o líder da mesa e contra a média
/// dela, nas proporções de `FIELD_LEADER_SHARE`/`FIELD_AVERAGE_SHARE`. Como as
/// duas somam 10 e com um oponente líder e média são o mesmo jogador, o valor
/// devolvido em duelo é idêntico ao da versão de dois jogadores.
pub fn evaluate(s: &Snapshot) -> i64 {
    let views = s.opponents_view();
    let living: Vec<&OppRef<'_>> = views.iter().filter(|o| o.is_alive()).collect();
    // Terminal domina tudo: nenhum material compensa ter perdido — e vencer só
    // acontece quando **todos** os oponentes saíram (CR 104.2a).
    if living.is_empty() {
        return TERMINAL;
    }
    if s.my_life <= 0 || s.my_poison >= 10 {
        return -TERMINAL;
    }
    // CR 903.10a — 21 de dano de um mesmo comandante mata, sobrando vida.
    if views
        .iter()
        .any(|o| o.commander_damage_to_me >= COMMANDER_LETHAL)
    {
        return -TERMINAL;
    }

    let mine = my_strength(s);
    let mut leader = i64::MIN;
    let mut total = 0i64;
    for o in &living {
        let st = opponent_strength(o);
        if st > leader {
            leader = st;
        }
        total += st;
    }
    let average = total / living.len() as i64;
    let mut v =
        ((mine - leader) * FIELD_LEADER_SHARE + (mine - average) * FIELD_AVERAGE_SHARE) / 10;

    // Cadeira vazia é relógio desligado: conta quem já saiu antes do retrato e
    // quem morreu dentro da própria previsão.
    let gone = s.eliminated_opponents + (views.len() - living.len());
    v += gone as i64 * OPPONENT_ELIMINATED;

    // Segundo relógio de vida (CR 903.10a). Fora de Commander todos os termos
    // são zero e a soma some.
    for o in &views {
        v -= o.commander_damage_to_me.clamp(0, COMMANDER_LETHAL) as i64 * COMMANDER_DAMAGE;
        v += o.my_commander_damage.clamp(0, COMMANDER_LETHAL) as i64 * COMMANDER_DAMAGE;
    }

    let incoming = incoming_damage(s);
    if incoming >= s.my_life {
        v -= LETHAL_THREAT;
    } else if incoming * 2 >= s.my_life {
        v -= LETHAL_THREAT / 4;
    }

    // A melhor eliminação disponível, não a do foco: com a mesa cheia o alvo
    // certo raramente é quem eu estava olhando.
    let mut kill_bonus = 0i64;
    for o in &living {
        let outgoing = outgoing_damage_against(s, o);
        let bonus = if outgoing >= o.life {
            LETHAL_CHANCE
        } else if outgoing * 2 >= o.life {
            LETHAL_CHANCE / 4
        } else {
            0
        };
        kill_bonus = kill_bonus.max(bonus);
    }
    // Tirar um de três não é ganhar a partida: metade do prêmio enquanto
    // sobrar mais de um oponente vivo.
    v += if living.len() == 1 {
        kill_bonus
    } else {
        kill_bonus / 2
    };

    if s.my_library == 0 {
        v -= DECKING;
    }
    for o in &living {
        if o.library == 0 {
            v += DECKING / living.len() as i64;
        }
    }

    v -= politics::leader_tax(mine, leader, living.len());
    v
}

/// Desempate estável por semente: splitmix64 sobre o índice da ação.
/// Não é aleatoriedade de jogo (essa só sai de `game.rng`) — é ruído de ±3
/// centipontos, para que sementes diferentes gerem partidas diferentes sem
/// jamais inverter uma decisão que importa.
pub fn jitter(seed: u64, index: usize) -> i64 {
    let mut x = seed ^ (index as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
    x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
    x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
    x ^= x >> 31;
    (x % 7) as i64 - 3
}
